#!/usr/bin/env python3
"""打印当前 TestAgent 用户 ID 和云端沙箱标识码。"""

from __future__ import annotations

import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener


HTTP_TIMEOUT_SECONDS = 10
MAX_RESPONSE_BYTES = 64 * 1024


class _NoRedirectHandler(HTTPRedirectHandler):
    """不跟随重定向，避免把请求发送到未配置的地址。"""

    def redirect_request(self, request, file, code, message, headers, new_url):
        return None


class _ServiceResponseError(Exception):
    def __init__(self, status: int, detail: str = ""):
        super().__init__(status, detail)
        self.status = status
        self.detail = detail


HTTP_CLIENT = build_opener(_NoRedirectHandler)


def _safe_identity(value: object) -> bool:
    return (
        isinstance(value, str)
        and bool(value)
        and value == value.strip()
        and not any(ord(character) < 32 or ord(character) == 127 for character in value)
    )


def _service_url() -> str:
    value = os.environ.get("TESTAGENT_CLOUD_SERVICE_URL", "")
    if not isinstance(value, str) or not value or value != value.strip():
        raise ValueError("服务地址配置无效")
    try:
        parsed = urlsplit(value)
        _ = parsed.port
        hostname = parsed.hostname
    except ValueError as error:
        raise ValueError("服务地址配置无效") from error
    if (
        parsed.scheme not in ("http", "https")
        or not parsed.netloc
        or not hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or any(ord(character) < 32 or ord(character) == 127 for character in value)
    ):
        raise ValueError("服务地址配置无效")
    return value.rstrip("/")


def _map_container_id(user_id: str, service_id: str) -> str:
    endpoint = _service_url() + "/user/map"
    body = json.dumps(
        {"user_id": user_id, "service_id": service_id},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    request = Request(
        endpoint,
        data=body,
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with HTTP_CLIENT.open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            status = response.getcode()
            raw_body = response.read(MAX_RESPONSE_BYTES + 1)
    except HTTPError as error:
        raise _ServiceResponseError(error.code) from error
    except (OSError, URLError, ValueError) as error:
        raise OSError("服务请求失败") from error

    if status != 200:
        raise _ServiceResponseError(status)
    if len(raw_body) > MAX_RESPONSE_BYTES:
        raise ValueError("服务响应过大")
    try:
        response_body = json.loads(raw_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("服务响应格式无效") from error
    if not isinstance(response_body, dict):
        raise ValueError("服务响应格式无效")
    container_id = response_body.get("container_id")
    if not _safe_identity(container_id):
        raise ValueError("服务响应缺少有效的云端沙箱标识码")
    return container_id


def _print_error(message: str) -> None:
    print(f"[print_testagent_help] 错误：{message}", file=sys.stderr)


def main() -> int:
    if len(sys.argv) != 1:
        _print_error("命令不接受参数；用法：print_testagent_help")
        return 1
    if os.environ.get("TESTAGENT_CLOUD_MODE") != "1":
        _print_error("云端模式未启用")
        return 1

    user_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_USER", "")
    service_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_ID", "")
    if not _safe_identity(user_id) or not _safe_identity(service_id):
        _print_error("用户 ID 或云端沙箱会话 ID 不可用")
        return 1

    try:
        container_id = _map_container_id(user_id, service_id)
    except _ServiceResponseError as error:
        if error.status == 403:
            _print_error("当前用户被禁止访问云端沙箱")
        elif error.status == 404:
            _print_error("未找到当前用户对应的云端沙箱")
        else:
            _print_error(f"服务端请求失败，HTTP 状态码={error.status}")
        return 1
    except ValueError as error:
        _print_error(str(error))
        return 1
    except OSError:
        _print_error("服务请求失败")
        return 1

    print(f"用户 ID: {user_id}")
    print(f"云端沙箱标识码: {container_id}")
    print(f"请复制以上内容输出给支持人员并寻求帮助，谢谢")
    return 0


try:
    raise SystemExit(main())
except Exception:
    _print_error("命令内部错误")
    raise SystemExit(1)
