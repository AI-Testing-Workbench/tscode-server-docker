#!/usr/bin/env python3

import base64
import json
import os
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener


CREDENTIAL_FILE = base64.b64decode(
    "L3Jvb3QvLmdpdC1oZWxwZXIvLmdpdC1jcmVkZW50aWFscw==", validate=True
).decode("ascii")
EXTRA_FILE = base64.b64decode(
    "L3Jvb3QvLmdpdC1oZWxwZXIvLmdpdC1leHRyYQ==", validate=True
).decode("ascii")
REJECTED_FILE = base64.b64decode(
    "L3Jvb3QvLmdpdC1oZWxwZXIvLnJ1bnRpbWUtY3JlZGVudGlhbC1yZWplY3RlZA==",
    validate=True,
).decode("ascii")
# 单次凭证 API 请求的超时和最大响应体大小。
HTTP_TIMEOUT_SECONDS = 10
MAX_RESPONSE_BYTES = 65536
# `.git-extra` 中允许持久化的非密码字段。
EXTRA_KEYS = ("type", "git_username", "git_email")


# 凭证 API 不跟随重定向，避免请求头被转发到其他地址。
class _NoRedirectHandler(HTTPRedirectHandler):
    def redirect_request(self, request, file, code, message, headers, new_url):
        return None


HTTP_CLIENT = build_opener(_NoRedirectHandler)


def _error(category):
    print("git credential helper error: " + category + " phase=runtime", file=sys.stderr)


def _progress(message):
    print("git credential helper progress: phase=runtime " + message, file=sys.stderr)


def _safe_protocol_value(value):
    return isinstance(value, str) and not any(
        character in value for character in ("\x00", "\r", "\n")
    )


def _safe_identity_value(value):
    return _safe_protocol_value(value) and not any(
        ord(character) < 32 or ord(character) == 127 for character in value
    )


def _read_request():
    fields = {}
    for raw_line in sys.stdin.buffer:
        if raw_line in (b"\n", b"\r\n"):
            break
        raw_line = raw_line.rstrip(b"\r\n")
        if b"=" not in raw_line:
            continue
        raw_key, raw_value = raw_line.split(b"=", 1)
        try:
            key = raw_key.decode("utf-8", "surrogateescape")
            value = raw_value.decode("utf-8", "surrogateescape")
        except UnicodeError:
            continue
        fields[key] = value
    return fields


def _credential_protocol(fields):
    lines = []
    for key in ("protocol", "host", "path", "username", "password"):
        if key not in fields:
            continue
        value = fields[key]
        if not _safe_protocol_value(value):
            return None
        lines.append(key + "=" + value + "\n")
    lines.append("\n")
    return "".join(lines).encode("utf-8", "surrogateescape")


def _regular_file(path):
    try:
        metadata = os.lstat(path)
        return stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1
    except OSError:
        return False


def _prepare_credential_file(create):
    if os.path.lexists(CREDENTIAL_FILE):
        if not _regular_file(CREDENTIAL_FILE):
            return False
    elif create:
        try:
            descriptor = os.open(
                CREDENTIAL_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600
            )
            os.close(descriptor)
        except OSError:
            return False
    else:
        return True
    try:
        os.chmod(CREDENTIAL_FILE, 0o600)
    except OSError:
        return False
    return True


def _credential_store(operation, fields):
    payload = _credential_protocol(fields)
    if payload is None:
        return False, ""
    try:
        result = subprocess.run(
            ["git", "credential-store", "--file", CREDENTIAL_FILE, operation],
            input=payload,
            stdout=subprocess.PIPE,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False, ""
    output = result.stdout.decode("utf-8", "replace")
    if result.returncode != 0:
        return False, output
    if operation in ("store", "erase") and not _prepare_credential_file(False):
        return False, output
    return True, output


def _parse_protocol_output(output):
    fields = {}
    for line in output.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value
    return fields


def _read_local_credential(request):
    if not _prepare_credential_file(False):
        return False, {}
    ok, output = _credential_store("get", request)
    return (True, _parse_protocol_output(output)) if ok else (False, {})


def _read_extra():
    if not os.path.lexists(EXTRA_FILE):
        return {}
    if not _regular_file(EXTRA_FILE):
        raise OSError("invalid extra file")
    values = {}
    with open(EXTRA_FILE, "r", encoding="utf-8", errors="replace") as stream:
        for line in stream:
            line = line.rstrip("\r\n")
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key in EXTRA_KEYS and _safe_identity_value(value):
                if key != "type" or value == "password":
                    values[key] = value
    return values


def _write_extra(values):
    items = []
    for key in EXTRA_KEYS:
        if key not in values:
            continue
        value = values[key]
        if not isinstance(value, str) or not _safe_identity_value(value):
            return False
        if value or key == "git_email":
            items.append((key, value))

    descriptor = None
    temporary_path = None
    try:
        descriptor, temporary_path = tempfile.mkstemp(
            prefix=".git-extra.", dir=str(Path(EXTRA_FILE).parent)
        )
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            descriptor = None
            for key, value in items:
                stream.write(key + "=" + value + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, EXTRA_FILE)
        temporary_path = None
        os.chmod(EXTRA_FILE, 0o600)
        return True
    except (OSError, ValueError):
        return False
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
        if temporary_path is not None:
            try:
                os.unlink(temporary_path)
            except OSError:
                pass


def _clear_local_credential(request):
    if not _prepare_credential_file(True):
        return False
    ok, _ = _credential_store("erase", request)
    return ok and _write_extra({})


def _git_config_value(key):
    try:
        result = subprocess.run(
            ["git", "config", "--global", "--get", key],
            stdout=subprocess.PIPE,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.decode("utf-8", "replace").rstrip("\r\n")
    return value if _safe_identity_value(value) else None


def _write_git_identity(username, email):
    if (
        not isinstance(username, str)
        or not isinstance(email, str)
        or not username
        or not _safe_identity_value(username)
        or not _safe_identity_value(email)
    ):
        return False
    try:
        for key, value in (("user.name", username), ("user.email", email)):
            result = subprocess.run(
                ["git", "config", "--global", "--replace-all", key, value],
                timeout=10,
                check=False,
            )
            if result.returncode != 0:
                return False
    except (OSError, subprocess.SubprocessError):
        return False
    return _git_config_value("user.name") == username and _git_config_value(
        "user.email"
    ) == email


def _apply_local_identity(stored):
    try:
        extra = _read_extra()
    except OSError:
        extra = {}
    username = extra.get("git_username") or stored.get("username", "")
    if not username:
        return True
    email = extra.get("git_email")
    if email is None:
        email = _git_config_value("user.email") or ""
    return _write_git_identity(username, email)


def _output_credential(request, stored):
    password = stored.get("password", "")
    if not _safe_protocol_value(password) or not password:
        return False
    try:
        extra = _read_extra()
    except OSError:
        extra = {}
    username = stored.get("username") or extra.get("git_username") or request.get(
        "username", ""
    )
    if username and not _safe_protocol_value(username):
        return False
    if username:
        sys.stdout.write("username=" + username + "\n")
    sys.stdout.write("password=" + password + "\n\n")
    sys.stdout.flush()
    _progress("credential provided")
    return True


def _valid_api_base(value):
    if not isinstance(value, str) or not value or value != value.strip():
        return False
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        return False
    try:
        parsed = urlsplit(value)
        _ = parsed.port
        hostname = parsed.hostname
    except ValueError:
        return False
    return (
        parsed.scheme in ("http", "https")
        and bool(parsed.netloc)
        and bool(hostname)
        and parsed.username is None
        and parsed.password is None
        and not parsed.query
        and not parsed.fragment
    )


def _api_context():
    service_url = os.environ.get("TESTAGENT_CLOUD_SERVICE_URL", "")
    service_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_ID", "")
    operator_user = os.environ.get("TESTAGENT_CLOUD_SERVICE_USER", "")
    if not _valid_api_base(service_url):
        raise ValueError("invalid service url")
    if not service_id or not _safe_identity_value(service_id):
        raise ValueError("invalid service id")
    if not operator_user or not _safe_identity_value(operator_user):
        raise ValueError("invalid operator")
    url = service_url.rstrip("/") + "/git/" + quote(service_id, safe="") + "/credential"
    return url, operator_user


def _request_credential():
    try:
        url, operator_user = _api_context()
        request = Request(
            url,
            headers={
                "Accept": "application/json",
                "X-Operator-User-ID": operator_user,
            },
            method="GET",
        )
        with HTTP_CLIENT.open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            status = response.getcode()
            body = response.read(MAX_RESPONSE_BYTES)
    except HTTPError as error:
        status = error.code
        error.close()
    except (OSError, URLError, TimeoutError, ValueError):
        _progress("runtime API credential unavailable; returning control to Git")
        return None
    _progress("api action=credential http_status=" + str(status))
    if status != 200:
        _progress("runtime API credential unavailable; returning control to Git")
        return None
    credential = _parse_api_credential(body)
    if credential is None:
        _progress("runtime API credential invalid; returning control to Git")
    return credential


def _parse_api_credential(body):
    try:
        response = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(response, dict) or response.get("type") != "password":
        return None
    username = response.get("git_username")
    email = response.get("git_email")
    password = response.get("git_password")
    if not isinstance(username, str) or not isinstance(email, str):
        return None
    if not isinstance(password, str):
        return None
    username = username.strip()
    email = email.strip()
    if not username or not password or not password.strip():
        return None
    if response.get("git_email") and not email:
        return None
    if not _safe_identity_value(username) or not _safe_identity_value(email):
        return None
    if not _safe_protocol_value(password):
        return None
    return {
        "type": "password",
        "git_username": username,
        "git_email": email,
        "git_password": password,
    }


def _save_api_credential(request, credential):
    local_request = dict(request)
    local_request["username"] = credential["git_username"]
    local_request["password"] = credential["git_password"]
    if not _prepare_credential_file(True):
        return False
    ok, _ = _credential_store("store", local_request)
    if not ok or not _write_extra(credential):
        return False
    return _write_git_identity(credential["git_username"], credential["git_email"])


def _rejection_pending():
    if not os.path.lexists(REJECTED_FILE):
        return False
    return True if _regular_file(REJECTED_FILE) else None


def _mark_rejection():
    descriptor = None
    temporary_path = None
    try:
        descriptor, temporary_path = tempfile.mkstemp(
            prefix=".runtime-credential-rejected.", dir=str(Path(REJECTED_FILE).parent)
        )
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="ascii", newline="\n") as stream:
            descriptor = None
            stream.write("rejected\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, REJECTED_FILE)
        temporary_path = None
        os.chmod(REJECTED_FILE, 0o600)
        return True
    except (OSError, ValueError):
        return False
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
        if temporary_path is not None:
            try:
                os.unlink(temporary_path)
            except OSError:
                pass


def _clear_rejection():
    if not os.path.lexists(REJECTED_FILE):
        return True
    if not _regular_file(REJECTED_FILE):
        return False
    try:
        os.unlink(REJECTED_FILE)
    except OSError:
        return False
    return True


def _handle_get(request):
    rejected = _rejection_pending()
    if rejected is None:
        _error("local")
        return 1
    if rejected:
        _progress("runtime credential rejected; returning empty credential without API")
        return 0

    local_ok, stored = _read_local_credential(request)
    if not local_ok:
        if not _clear_local_credential(request) or not _mark_rejection():
            _error("local")
            return 1
        _progress("runtime local credential unreadable; returning empty credential without API")
        return 0
    if stored.get("password"):
        if not _apply_local_identity(stored):
            _error("local")
        if _output_credential(request, stored):
            return 0
        if not _clear_local_credential(request) or not _mark_rejection():
            _error("local")
            return 1
        _progress("runtime local credential invalid; returning empty credential without API")
        return 0

    _progress("runtime local credential unavailable; trying API")
    credential = _request_credential()
    if credential is None:
        return 0
    if not _save_api_credential(request, credential):
        _progress("runtime API credential local save failed; using API credential")
    output = {
        "username": credential["git_username"],
        "password": credential["git_password"],
    }
    if _output_credential(request, output):
        return 0
    if not _clear_local_credential(request) or not _mark_rejection():
        _error("local")
        return 1
    _error("local")
    return 1


def _stored_identity(request, extra):
    configured_username = _git_config_value("user.name")
    username = (
        request.get("username")
        or request.get("git_username")
        or configured_username
        or extra.get("git_username", "")
    )
    if isinstance(request.get("git_email"), str):
        email = request["git_email"]
    else:
        configured_email = _git_config_value("user.email")
        email = (
            configured_email
            if configured_email is not None
            else extra.get("git_email", "")
        )
    return username, email


def _handle_store(request):
    password = request.get("password", "")
    if not password:
        return 0
    if not _safe_protocol_value(password):
        _error("invalid_credential")
        return 0
    try:
        extra = _read_extra()
    except OSError:
        extra = {}
    username, email = _stored_identity(request, extra)
    local_request = dict(request)
    if username:
        local_request["username"] = username
    else:
        local_request.pop("username", None)
    local_ok, stored = _read_local_credential(request)
    unchanged = (
        local_ok
        and stored.get("password") == password
        and (not username or stored.get("username", "") == username)
    )
    if not _prepare_credential_file(True):
        _error("local")
        return 1
    ok, _ = _credential_store("store", local_request)
    if not ok or not _write_extra(
        {"type": "password", "git_username": username, "git_email": email}
    ):
        _error("local")
        return 1
    if username and not _write_git_identity(username, email):
        _error("local")
        return 1
    if not _clear_rejection():
        _error("local")
        return 1
    if unchanged:
        _progress("runtime credential already stored; upload prompt skipped")
        return 0

    _progress("runtime local credential store complete")
    print(
        "\033[1;33m[TS Code] 码云凭证已保存至本地，并且将随着云端服务的销毁而删除，如需持久化使用，请手动执行 testagent-cloud upload 命令以加密上传至 TestAgent Cloud "
        "数据库\033[0m",
        file=sys.stderr,
    )
    return 0


def _handle_erase(request):
    if not _clear_local_credential(request) or not _mark_rejection():
        _error("local")
        return 1
    _progress("runtime credential cleared; subsequent lookups use empty credential without API")
    return 0


def _main():
    operation = sys.argv[1] if len(sys.argv) > 1 else "get"
    if operation not in {"get", "store", "erase"}:
        _error("unsupported_operation")
        return 1
    request = _read_request()
    if operation == "get":
        return _handle_get(request)
    if operation == "store":
        return _handle_store(request)
    return _handle_erase(request)


def main():
    try:
        return _main()
    except (KeyboardInterrupt, SystemExit):
        raise
    except Exception:
        _error("internal")
        return 1


raise SystemExit(main())
