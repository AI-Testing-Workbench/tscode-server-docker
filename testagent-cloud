#!/usr/bin/env python3
"""TestAgent Cloud 用户命令。"""

from __future__ import annotations

import base64
import json
import os
import stat
import sys
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote, unquote, urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener


CREDENTIAL_FILE = Path(
    base64.b64decode(
        "L3Jvb3QvLmdpdC1oZWxwZXIvLmdpdC1jcmVkZW50aWFscw==", validate=True
    ).decode("utf-8")
)
EXTRA_FILE = Path(
    base64.b64decode(
        "L3Jvb3QvLmdpdC1oZWxwZXIvLmdpdC1leHRyYQ==", validate=True
    ).decode("utf-8")
)
HTTP_TIMEOUT_SECONDS = 10
MAX_RESPONSE_BYTES = 64 * 1024


class _NoRedirectHandler(HTTPRedirectHandler):
    """不跟随重定向，避免请求发送到未配置的地址。"""

    def redirect_request(self, request, file, code, message, headers, new_url):
        return None


class _ServiceRejected(Exception):
    def __init__(self, status: int, detail: str = ""):
        super().__init__(status, detail)
        self.status = status
        self.detail = detail


HTTP_CLIENT = build_opener(_NoRedirectHandler)


def _safe_value(value: object) -> bool:
    return isinstance(value, str) and "\x00" not in value and "\r" not in value and "\n" not in value


def _safe_identity(value: object) -> bool:
    return (
        _safe_value(value)
        and bool(value)
        and value == value.strip()
        and not any(ord(character) < 32 or ord(character) == 127 for character in value)
    )


def _regular_file(path: Path) -> bool:
    try:
        metadata = os.lstat(path)
    except OSError:
        return False
    return (
        not os.path.islink(path)
        and stat.S_ISREG(metadata.st_mode)
        and metadata.st_nlink == 1
        and stat.S_IMODE(metadata.st_mode) == 0o600
    )


def _read_extra() -> dict[str, str]:
    if not os.path.lexists(EXTRA_FILE):
        return {}
    if not _regular_file(EXTRA_FILE):
        raise OSError("invalid extra file")
    values: dict[str, str] = {}
    with open(EXTRA_FILE, "r", encoding="utf-8", errors="replace") as stream:
        for line in stream:
            line = line.rstrip("\r\n")
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key not in ("type", "git_username", "git_email") or not _safe_identity(value):
                continue
            if key == "type" and value != "password":
                continue
            values[key] = value
    return values


def _latest_credential() -> dict[str, str]:
    if not _regular_file(CREDENTIAL_FILE):
        return {}
    latest: dict[str, str] = {}
    try:
        with open(CREDENTIAL_FILE, "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                line = line.strip()
                if not line:
                    continue
                try:
                    parsed = urlsplit(line)
                    _ = parsed.port
                except ValueError:
                    continue
                if parsed.scheme not in ("http", "https") or not parsed.hostname:
                    continue
                username = unquote(parsed.username or "")
                password = unquote(parsed.password or "")
                if _safe_value(username) and _safe_value(password) and password:
                    latest = {"username": username, "password": password}
    except OSError:
        return {}
    return latest


def _service_url() -> str:
    value = os.environ.get("TESTAGENT_CLOUD_SERVICE_URL", "")
    if not isinstance(value, str) or not value or value != value.strip():
        raise ValueError("服务地址配置无效")
    try:
        parsed = urlsplit(value)
        _ = parsed.port
        hostname = parsed.hostname
    except ValueError as error:
        raise ValueError("服务地址配置无效") from error
    if (
        parsed.scheme not in ("http", "https")
        or not parsed.netloc
        or not hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or any(ord(character) < 32 or ord(character) == 127 for character in value)
    ):
        raise ValueError("服务地址配置无效")
    return value.rstrip("/")


def _upload_credential(username: str, email: str, password: str) -> None:
    service_user = os.environ.get("TESTAGENT_CLOUD_SERVICE_USER", "")
    service_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_ID", "")
    if (
        not service_user
        or not service_id
        or not _safe_identity(service_user)
        or not _safe_identity(service_id)
    ):
        raise ValueError("服务身份不可用")
    endpoint = _service_url() + "/git/" + quote(service_id, safe="") + "/credential"
    body = json.dumps(
        {
            "type": "password",
            "git_username": username,
            "git_email": email,
            "git_password": password,
            "persist": True,
        },
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    request = Request(
        endpoint,
        data=body,
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-Operator-User-ID": service_user,
        },
        method="POST",
    )
    try:
        with HTTP_CLIENT.open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            status = response.getcode()
    except HTTPError as error:
        status = error.code
    except (OSError, URLError, ValueError) as error:
        raise OSError("服务请求失败") from error
    if status != 204:
        raise _ServiceRejected(status)


def _map_container_id(user_id: str, service_id: str) -> str:
    endpoint = _service_url() + "/user/map"
    body = json.dumps(
        {"user_id": user_id, "service_id": service_id},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    request = Request(
        endpoint,
        data=body,
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with HTTP_CLIENT.open(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            status = response.getcode()
            raw_body = response.read(MAX_RESPONSE_BYTES + 1)
    except HTTPError as error:
        raise _ServiceRejected(error.code) from error
    except (OSError, URLError, ValueError) as error:
        raise OSError("服务请求失败") from error

    if status != 200:
        raise _ServiceRejected(status)
    if len(raw_body) > MAX_RESPONSE_BYTES:
        raise ValueError("服务响应过大")
    try:
        response_body = json.loads(raw_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("服务响应格式无效") from error
    if not isinstance(response_body, dict):
        raise ValueError("服务响应格式无效")
    container_id = response_body.get("container_id")
    if not _safe_identity(container_id):
        raise ValueError("服务响应缺少有效的云端沙箱标识码")
    return container_id


def _print_usage() -> None:
    print(
        "用法：\n"
        "  testagent-cloud upload\n"
        "  testagent-cloud debug",
        file=sys.stderr,
    )


def _print_upload_success(message: str) -> None:
    print(f"\033[1;32m[TestAgent Cloud] {message}\033[0m", file=sys.stderr)


def _print_upload_error(category: str, detail: str = "") -> None:
    messages = {
        "cloud_mode_required": "云端模式未启用",
        "extra_file": "本地身份文件不可用",
        "credential_type": "本地凭证类型不支持",
        "credential_file": "本地凭证文件不可用",
        "credential_missing": "未找到可上传的本地凭证",
        "credential_incomplete": "本地凭证信息不完整",
        "service_configuration": "服务配置无效",
        "service_request": "上传请求失败",
        "service_rejected": "服务端拒绝凭证",
        "arguments_not_supported": "命令参数不正确",
        "internal": "上传命令内部错误",
    }
    summary = messages.get(category, "上传失败")
    suffix = " " + detail if detail else ""
    print(
        f"\033[1;31m[TestAgent Cloud] 错误：{summary}{suffix}\033[0m",
        file=sys.stderr,
    )


def _print_debug_error(message: str) -> None:
    print(f"[TestAgent Cloud] 错误：{message}", file=sys.stderr)


def _upload_command() -> int:
    if os.environ.get("TESTAGENT_CLOUD_MODE") != "1":
        _print_upload_error("cloud_mode_required")
        return 1
    try:
        extra = _read_extra()
    except OSError:
        _print_upload_error("extra_file")
        return 1
    if extra.get("type", "password") != "password":
        _print_upload_error("credential_type")
        return 1
    stored = _latest_credential()
    if not stored:
        _print_upload_error("credential_missing")
        return 1
    username = stored.get("username") or extra.get("git_username", "")
    email = extra.get("git_email", "")
    password = stored.get("password", "")
    if (
        not _safe_identity(username)
        or not username
        or not username.strip()
        or not _safe_identity(email)
        or (email and not email.strip())
        or not _safe_value(password)
        or not password
        or not password.strip()
    ):
        _print_upload_error("credential_incomplete")
        return 1
    try:
        _upload_credential(username, email, password)
    except _ServiceRejected as error:
        _print_upload_error("service_rejected", f"HTTP 状态码={error.status}")
        return 1
    except ValueError:
        _print_upload_error("service_configuration")
        return 1
    except OSError:
        _print_upload_error("service_request")
        return 1
    _print_upload_success("已成功加密上传码云信息！")
    return 0


def _debug_command() -> int:
    if os.environ.get("TESTAGENT_CLOUD_MODE") != "1":
        _print_debug_error("云端模式未启用")
        return 1
    user_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_USER", "")
    service_id = os.environ.get("TESTAGENT_CLOUD_SERVICE_ID", "")
    if not _safe_identity(user_id) or not _safe_identity(service_id):
        _print_debug_error("用户 ID 或云端沙箱会话 ID 不可用")
        return 1
    try:
        container_id = _map_container_id(user_id, service_id)
    except _ServiceRejected as error:
        if error.status == 403:
            _print_debug_error("当前用户被禁止访问云端沙箱")
        elif error.status == 404:
            _print_debug_error("未找到当前用户对应的云端沙箱")
        else:
            _print_debug_error(f"服务端请求失败，HTTP 状态码={error.status}")
        return 1
    except ValueError as error:
        _print_debug_error(str(error))
        return 1
    except OSError:
        _print_debug_error("服务请求失败")
        return 1
    print(f"用户 ID: {user_id}")
    print(f"云端沙箱标识码: {container_id}")
    print("请复制以上内容输出给支持人员并寻求帮助，谢谢")
    return 0


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        _print_usage()
        return 0
    if len(sys.argv) != 2:
        _print_usage()
        return 1
    if sys.argv[1] == "upload":
        return _upload_command()
    if sys.argv[1] == "debug":
        return _debug_command()
    _print_usage()
    return 1


try:
    raise SystemExit(main())
except Exception:
    print("\033[1;31m[TestAgent Cloud] 错误：命令内部错误\033[0m", file=sys.stderr)
    raise SystemExit(1)
